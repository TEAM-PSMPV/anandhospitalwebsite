# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.nyc_output/

# next.js
/.next/
/out/

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.p12
*.pfx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/.cache-archive*
/.asset-archive*
/.dist-*
/.sites-runtime/
/outputs/
/work/

# Local AI/editor agent metadata and generated hosting metadata
/.openai/
/.agents/
/.codex/

# IDE and local tooling
/.idea/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json
*.swp
*.swo

# Local databases and Cloudflare state
*.sqlite
*.sqlite3
/.dev.vars*
!.dev.vars.example

# Reports and temporary files
/test-results/
/playwright-report/
*.log
*.tmp
